# =============================================================================
# FiapCloudGames — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores antes de rodar docker compose
# O arquivo .env NUNCA deve ser commitado no repositório
# =============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=troque_esta_senha

# ─── RabbitMQ (desenvolvimento local) ────────────────────────────────────────
RABBITMQ_USER=fcg_rmq
RABBITMQ_PASSWORD=troque_esta_senha

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=troque_esta_senha

# ─── JWT (mínimo 32 caracteres) ───────────────────────────────────────────────
JWT_KEY=troque_esta_chave_com_minimo_32_chars

# ─── AWS (produção — deploy via SAM em infrastructure/sam/) ──────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua_access_key
AWS_SECRET_ACCESS_KEY=sua_secret_key

# URLs dos serviços backend (para o API Gateway AWS)
# Preencha após provisionar o load balancer/EKS
USERS_API_URL=https://seu-load-balancer.amazonaws.com
CATALOG_API_URL=https://seu-load-balancer.amazonaws.com

# URLs das filas SQS (geradas após 'sam deploy' — ver Outputs)
SQS_USER_CREATED_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/fcg-user-created-events-production
SQS_PAYMENT_PROCESSED_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/ACCOUNT_ID/fcg-payment-processed-events-production

# ─── Datadog (Observabilidade — Opção B) ─────────────────────────────────────
# Obtenha a API key em https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=sua_api_key_datadog
DD_SITE=datadoghq.com
