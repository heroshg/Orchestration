# =============================================================================
# FiapCloudGames — Template de Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# cp .env.example .env
# O arquivo .env NUNCA deve ser commitado no repositório
# =============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=fcg_rmq
RABBITMQ_PASSWORD=CHANGE_ME

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ─── JWT (uma chave por serviço — gere com: openssl rand -base64 32) ──────────
JWT_KEY_USERS=CHANGE_ME
JWT_KEY_CATALOG=CHANGE_ME
JWT_KEY_PAYMENTS=CHANGE_ME

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# URLs dos serviços backend
USERS_API_URL=
CATALOG_API_URL=

# URLs das filas SQS (geradas após 'sam deploy')
SQS_USER_CREATED_QUEUE_URL=
SQS_PAYMENT_PROCESSED_QUEUE_URL=

# ─── Datadog ──────────────────────────────────────────────────────────────────
# Obtenha a API key em https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=CHANGE_ME
DD_SITE=datadoghq.com
