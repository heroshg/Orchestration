# =============================================================================
# FiapCloudGames — Template de Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais
# cp .env.example .env
# O arquivo .env NUNCA deve ser commitado no repositório
# =============================================================================

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE_ME

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=fcg_rmq
RABBITMQ_PASSWORD=CHANGE_ME

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ─── JWT (RSA RS256 — par de chaves único do domínio FCG) ────────────────────
# Gere com: bash infrastructure/scripts/generate-jwt-keys.sh
# - UsersAPI usa a chave privada (assina) + pública (expõe no /.well-known/jwks.json)
# - CatalogAPI e PaymentsAPI usam apenas a chave pública (validam tokens)
# - AWS API Gateway busca a chave pública via JWKS endpoint (Authorizer JWT nativo)
JWT_RSA_PRIVATE_KEY=CHANGE_ME_base64_PEM
JWT_RSA_PUBLIC_KEY=CHANGE_ME_base64_PEM

# Opcional — PEM decodificado (Kong consome direto via vault://env). Se vazio,
# o entrypoint do Kong decodifica JWT_RSA_PUBLIC_KEY automaticamente.
# Para preencher manualmente use aspas e quebras de linha reais (compose v2.24+):
# JWT_RSA_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----
# MIIBIjANBgkq...
# -----END PUBLIC KEY-----"
JWT_RSA_PUBLIC_KEY_PEM=

# ─── AWS ──────────────────────────────────────────────────────────────────────
# Dev local com LocalStack: deixe a região como us-east-1 e use credenciais "test".
# Em produção, use credenciais reais via aws configure / IAM role.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# URLs dos serviços backend
USERS_API_URL=
CATALOG_API_URL=

# URLs das filas SQS — em dev local são preenchidas automaticamente pelo
# docker-compose apontando para o LocalStack. Em produção, valores gerados
# após 'terraform apply' / 'sam deploy'.
SQS_USER_CREATED_QUEUE_URL=
SQS_PAYMENT_PROCESSED_QUEUE_URL=

# ─── Datadog ──────────────────────────────────────────────────────────────────
# Obtenha a API key em https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=CHANGE_ME
DD_SITE=datadoghq.com
