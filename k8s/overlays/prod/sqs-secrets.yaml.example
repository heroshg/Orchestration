# =============================================================================
# Template do Secret de SQS para o ambiente de produção (EKS).
# Copie para sqs-secrets.yaml e popule os valores a partir dos outputs do
# Terraform:
#   terraform -chdir=infrastructure/terraform output -raw sqs_user_created_queue_url
#   terraform -chdir=infrastructure/terraform output -raw sqs_payment_processed_queue_url
#
# Em EKS o ideal é usar IRSA (IAM Roles for Service Accounts) ao invés de
# AWS_ACCESS_KEY_ID/SECRET — basta remover essas duas chaves daqui e anotar
# a ServiceAccount do deployment com `eks.amazonaws.com/role-arn`.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: users-api-sqs
  namespace: fcg
type: Opaque
stringData:
  AWS__SQS__UserCreatedQueueUrl: "REPLACE_WITH_TERRAFORM_OUTPUT"
  # Remover se usar IRSA:
  AWS_ACCESS_KEY_ID: "REPLACE_ME"
  AWS_SECRET_ACCESS_KEY: "REPLACE_ME"
---
apiVersion: v1
kind: Secret
metadata:
  name: payments-api-sqs
  namespace: fcg
type: Opaque
stringData:
  AWS__SQS__PaymentProcessedQueueUrl: "REPLACE_WITH_TERRAFORM_OUTPUT"
  AWS_ACCESS_KEY_ID: "REPLACE_ME"
  AWS_SECRET_ACCESS_KEY: "REPLACE_ME"
