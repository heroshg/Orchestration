environment          = "production"
aws_region           = "us-east-1"

# ─── JWT (gere cada uma com: openssl rand -base64 32) ─────────────────────────
jwt_key_users    = "CHANGE_ME"
jwt_key_catalog  = "CHANGE_ME"
jwt_key_payments = "CHANGE_ME"

# ─── Banco de dados ───────────────────────────────────────────────────────────
db_password  = "CHANGE_ME"
rmq_password = "CHANGE_ME"

# ─── Datadog ──────────────────────────────────────────────────────────────────
# Obtenha em: https://app.datadoghq.com/organization-settings/api-keys
dd_api_key           = "CHANGE_ME"
dd_app_key           = "CHANGE_ME"
dd_site              = "datadoghq.com"
dd_extension_version = "62"
