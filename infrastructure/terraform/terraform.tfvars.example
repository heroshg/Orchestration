environment          = "production"
aws_region           = "us-east-1"

# ─── JWT (RSA — gere com: bash infrastructure/scripts/generate-jwt-keys.sh) ──
# As três APIs compartilham a mesma chave pública para validar.
# Apenas a UsersAPI tem acesso à chave privada (assina os tokens).
jwt_rsa_private_key = "CHANGE_ME_base64_pem"
jwt_rsa_public_key  = "CHANGE_ME_base64_pem"
jwt_issuer          = "FiapCloudGames"
jwt_audience        = "FiapCloudGames"

# ─── Banco de dados ───────────────────────────────────────────────────────────
db_password  = "CHANGE_ME"
rmq_password = "CHANGE_ME"

# ─── Datadog ──────────────────────────────────────────────────────────────────
# Obtenha em: https://app.datadoghq.com/organization-settings/api-keys
dd_api_key           = "CHANGE_ME"
dd_app_key           = "CHANGE_ME"
dd_site              = "datadoghq.com"
dd_extension_version = "62"
